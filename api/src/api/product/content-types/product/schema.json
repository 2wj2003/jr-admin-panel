{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 250,
      "regex": "^[ก-๙a-z0-9]+(?:-[ก-๙a-z0-9]+)*$"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "sku": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "originalPrice": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 0
    },
    "discountPrice": {
      "type": "integer",
      "min": 0
    },
    "description": {
      "type": "richtext"
    },
    "warrantyDuration": {
      "type": "integer",
      "default": 3
    },
    "warrantyDurationUnit": {
      "type": "enumeration",
      "enum": [
        "DAYS",
        "MONTHS",
        "YEARS"
      ],
      "default": "YEARS"
    },
    "warrantyDescription": {
      "type": "richtext"
    },
    "medias": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "files": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand",
      "inversedBy": "products"
    },
    "instalment": {
      "type": "integer",
      "default": 0
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "keyFeature": {
      "type": "richtext",
      "required": false
    },
    "specification": {
      "type": "richtext"
    },
    "position": {
      "type": "integer",
      "default": 9999
    },
    "installation": {
      "type": "boolean",
      "default": false
    },
    "resolution": {
      "type": "enumeration",
      "enum": [
        "cctv-2mp",
        "cctv-3mp",
        "cctv-4mp",
        "cctv-5mp",
        "cctv-8mp"
      ]
    }
  }
}
